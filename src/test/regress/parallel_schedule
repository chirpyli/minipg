# ----------
# src/test/regress/parallel_schedule
#
# By convention, we put no more than twenty tests in any one parallel group;
# this limits the number of connections needed to run the tests.
# ----------

# run tablespace by itself, and first, because it forces a checkpoint;
# we'd prefer not to have checkpoints later in the tests because that
# interferes with crash-recovery testing.
# tablespace: 依赖 GRANT/ROLE 权限机制，已裁剪，移除

# ----------
# The first group of parallel tests
# ----------
test: boolean char varchar text int2 int4 int8 oid float4 float8 pg_lsn

# ----------
# The second group of parallel tests
# strings depends on char, varchar and text
# numerology depends on int2, int4, int8, float4, float8
# multirangetypes 已随 range/multirange 具体类型裁剪而移除
# ----------
test: strings numerology date time timestamp timestamptz 

# ----------
# Another group of parallel tests
# horology depends on interval, timestamp, timestamptz
test: horology misc_sanity comments xid mvcc euc_kr

# ----------
# These four each depend on the previous one
# ----------
test: create_table
# create_index 为 onek/tenk1/bt_*_heap/hash_*_heap 等基础表建立索引，
# sanity_check 等测试依赖这些索引
test: create_index

# ----------
# Load huge amounts of data
# We should split the data files into single files and then
# execute two copy tests parallel, to check that copy itself
# is concurrent safe.
# ----------
# copy 已随表继承(INHERITS)功能裁剪而移除（依赖 emp/student/stud_emp 继承表）
# insert_conflict 已随表继承(INHERITS)功能裁剪而移除
# copyselect/copydml 已随 SQL COPY 命令裁剪而移除
test: insert

# ----------
# More groups of parallel tests
# ----------
test: create_misc
test: index_including

# ----------
# Another group of parallel tests
# ----------
# 权限/角色机制已裁剪，以下测试深度依赖角色，移除：
#   constraints vacuum create_function_3 database
# typed_table 已随 CREATE TYPE 裁剪而移除（typed table 依赖 CREATE TYPE 创建复合类型）
# information_schema 已裁剪，triggers/updatable_views 深度依赖 information_schema，移除
# inherit 已随表继承(INHERITS)功能裁剪而移除
test: hash_func

# ----------
# sanity_check does a vacuum, affecting the sort order of SELECT *
# results. So it should not run parallel to other tests.
# ----------
test: sanity_check

# ----------
# Another group of parallel tests
# Note: the ignore: line does not run random, just mark it as ignorable
# ----------
ignore: random
# information_schema 已裁剪，join 引用 information_schema.cardinal_number，移除
# CREATE TABLE AS (CTAS) 语法已裁剪，random 测试依赖该语法，移除
# aggregates/portals 已随表继承(INHERITS)功能裁剪而移除
test: select_distinct select_distinct_on select_implicit select_having btree_index hash_index prepared_xacts

# ----------
# Another group of parallel tests
# ----------
# 权限/角色机制已裁剪，matview identity generated 依赖 ROLE/OWNER，移除
# information_schema 已裁剪，collate 引用 information_schema.views，移除
# lock 已随表继承(INHERITS)功能裁剪而移除
test: tablesample join_hash

# ----------
# Another group of parallel tests
# ----------
# misc 已随表继承(INHERITS)功能裁剪而移除（依赖 stud_emp/emp 继承表）
# create_table_like 已随表继承(INHERITS)功能裁剪而移除
test: dbsize misc_functions sysviews tsrf tidscan tidrangescan

# rules cannot run concurrently with any test that creates
# a view or rule in the public schema
# collate.*.utf8 tests cannot be run in parallel with each other
# information_schema 已裁剪，collate.linux.utf8 引用 information_schema，移除
# rules 已随表继承(INHERITS)功能裁剪而移除
test: psql_crosstab

# run by itself so it can run parallel workers
# information_schema 已裁剪，select_parallel 引用 information_schema，移除
test: write_parallel
test: vacuum_parallel

# Run this alone, because concurrent DROP TABLE would make non-superuser
# "ANALYZE;" fail with "relation with OID $n does not exist".
# maintain_every 已随表继承(INHERITS)功能裁剪而移除

# no relation related tests can be put in this group
# publication subscription: 权限/角色机制已裁剪，依赖 REPLICATION 角色权限，移除

# ----------
# Another group of parallel tests
# ----------
# 权限/角色机制已裁剪，以下依赖角色/OWNER，移除：
#   select_views foreign_key dependency alter_table sequence largeobject
# cluster 已随表继承(INHERITS)功能裁剪而移除
# portals_p2 已随游标功能裁剪而移除
test: bitmapops combocid advisory_lock

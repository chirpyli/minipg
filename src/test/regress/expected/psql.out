--
-- Tests for psql features that aren't closely connected to any
-- specific server features.
--
-- This is a trimmed version covering only the commands retained in
-- minipg's psql: \c \g \gx \d \dt \l \x \q plus the test-suite helpers
-- \i \set \unset \pset \a \t \if \echo and the special result variables.
--
-- \set / \unset / \echo
\set foo bar
\echo :foo
bar
\set num 42
\echo :num
42
\unset foo
\unset num
-- \pset / \a / \t
\pset format aligned
\pset null '(null)'
\a
\t
-- \g / \gx
SELECT 1 AS one, 2 AS two \g
1|2
\gx
one|1
two|2
SELECT 3 AS three, 4 AS four \gx
three|3
four|4
\g
3|4
-- \x expanded display
\x on
SELECT 1 AS a, 2 AS b;
a|1
b|2
\x off
-- special result variables
SELECT 1 / 0;
ERROR:  division by zero
\echo :ERROR
true
\echo :SQLSTATE
22012
SELECT 1;
1
\echo :ROW_COUNT
1
-- \if / \endif
\if true
  \echo branch_taken
branch_taken
\endif
\if false
  \echo should_not_appear
\endif
-- \i include a script file
\i data/psql_incl.sql
-- included by psql.sql to exercise \i
SELECT 'included' AS msg;
included
-- describe / list on a temp table
CREATE TABLE psql_test (id int, val text);
\d psql_test
id|integer
val|text
\dt psql_test
public|psql_test|table
DROP TABLE psql_test;
-- list databases
\l
postgres|SQL_ASCII|C|C
regression|SQL_ASCII|C|C
template0|SQL_ASCII|C|C
template1|SQL_ASCII|C|C

SELECT n.nspname, c.conname, 'postgres'::name AS rolname
  FROM pg_conversion c, pg_namespace n
  WHERE c.connamespace = n.oid
    AND n.nspname IN ('alt_nsp1', 'alt_nsp2')
  ORDER BY nspname, conname;

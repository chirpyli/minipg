CREATE OPERATOR FAMILY alt_opf11 USING gist;
ERROR:  access method "gist" does not exist
ALTER OPERATOR FAMILY alt_opf11 USING gist ADD OPERATOR 1 < (int4, int4) FOR ORDER BY float_ops;
ERROR:  access method "gist" does not exist

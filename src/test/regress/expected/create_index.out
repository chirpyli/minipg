(1 row)

SELECT pg_get_indexdef('concur_exprs_index_pred_2'::regclass);
                                                          pg_get_indexdef                                                           
------------------------------------------------------------------------------------------------------------------------------------
 CREATE UNIQUE INDEX concur_exprs_index_pred_2 ON public.concur_exprs_tab USING btree (((1 / c1))) WHERE ('-H'::text >= (c2)::text)
(1 row)

REINDEX TABLE CONCURRENTLY concur_exprs_tab;

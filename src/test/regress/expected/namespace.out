--
-- Regression tests for schemas (namespaces)
--
-- set the whitespace-only search_path to test that the
-- GUC list syntax is preserved during a schema creation
SELECT pg_catalog.set_config('search_path', ' ', false);
 set_config 
------------
  
(1 row)

CREATE SCHEMA test_ns_schema_1
       CREATE UNIQUE INDEX abc_a_idx ON abc (a)
       CREATE TABLE abc (
              a int,
              b int UNIQUE
       );
-- verify that the correct search_path restored on abort
SET search_path to public;
BEGIN;
SET search_path to public, test_ns_schema_1;
CREATE SCHEMA test_ns_schema_2
       CREATE TABLE abc (c nosuchtype);
ERROR:  type "nosuchtype" does not exist
LINE 2:        CREATE TABLE abc (c nosuchtype);
                                   ^
COMMIT;
SHOW search_path;
 search_path 
-------------
 public
(1 row)

-- verify that the correct search_path preserved
-- after creating the schema and on commit
BEGIN;
SET search_path to public, test_ns_schema_1;
CREATE SCHEMA test_ns_schema_2
       CREATE TABLE abc (a int);
SHOW search_path;
       search_path        
--------------------------
 public, test_ns_schema_1
(1 row)

COMMIT;
SHOW search_path;
       search_path        
--------------------------
 public, test_ns_schema_1
(1 row)

DROP SCHEMA test_ns_schema_2 CASCADE;
NOTICE:  drop cascades to table test_ns_schema_2.abc
-- verify that the objects were created
SELECT relname FROM pg_class WHERE relnamespace =
    (SELECT oid FROM pg_namespace WHERE nspname = 'test_ns_schema_1') ORDER BY relname;
  relname  
-----------
 abc
 abc_a_idx
 abc_b_key
(3 rows)

-- minipg: DEFAULT VALUES 已裁剪，改为显式插入
INSERT INTO test_ns_schema_1.abc (a, b) VALUES (1, 1);
INSERT INTO test_ns_schema_1.abc (a, b) VALUES (2, 2);
INSERT INTO test_ns_schema_1.abc (a, b) VALUES (3, 3);
SELECT * FROM test_ns_schema_1.abc;
 a | b 
---+---
 1 | 1
 2 | 2
 3 | 3
(3 rows)

-- minipg: ALTER SCHEMA ... RENAME 已裁剪，无法改名，直接对原 schema 断言
SELECT relname FROM pg_class WHERE relnamespace =
    (SELECT oid FROM pg_namespace WHERE nspname = 'test_ns_schema_1') ORDER BY relname;
  relname  
-----------
 abc
 abc_a_idx
 abc_b_key
(3 rows)

-- test IF NOT EXISTS cases
CREATE SCHEMA test_ns_schema_1; -- fail, already exists
ERROR:  schema "test_ns_schema_1" already exists
CREATE SCHEMA IF NOT EXISTS test_ns_schema_1; -- ok with notice
NOTICE:  schema "test_ns_schema_1" already exists, skipping
CREATE SCHEMA IF NOT EXISTS test_ns_schema_1 -- fail, disallowed
       CREATE TABLE abc (
              a int,
              b int UNIQUE
       );
ERROR:  CREATE SCHEMA IF NOT EXISTS cannot include schema elements
LINE 2:        CREATE TABLE abc (
               ^
DROP SCHEMA test_ns_schema_1 CASCADE;
NOTICE:  drop cascades to table abc
-- verify that the objects were dropped
SELECT relname FROM pg_class WHERE relnamespace =
    (SELECT oid FROM pg_namespace WHERE nspname = 'test_ns_schema_1') ORDER BY relname;
 relname 
---------
(0 rows)


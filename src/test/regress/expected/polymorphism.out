create function dfunc(int = 1, int = 2, int = 3) returns int as $$
  select 3;
$$ language sql;
create function dfunc(int = 1, int = 2) returns int as $$
  select 2;
$$ language sql;
create function dfunc(text) returns text as $$
  select $1;
$$ language sql;
